# Local settings for the API. Copy to api/.env (git-ignored); Spring Boot reads it on startup.
# Staging and production values live only in the host's dashboard and GitHub Actions secrets.

# Must match the database in docker-compose.yml / .env
DB_URL=jdbc:postgresql://localhost:5432/slotted
DB_USERNAME=slotted
DB_PASSWORD=change-me-local-only

# Signs access tokens (ADR-0002). At least 32 random characters, different in every environment.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters

# Web origins allowed to call the API, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First admin account, created on startup if there is no admin yet. Use your own email and a
# password of at least 10 characters that is not a common password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Local Admin
